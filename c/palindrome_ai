#include <stdio.h>
int main() {
    int num, copy, digit,rev = 0;
    printf("Enter a number");
    scanf("%d", &num);
    copy = num;
    while (num > 0) 
    digit = num % 10,
    rev = (rev * 10) + digit,
    num = num / 10;

    if (copy == rev) 
    printf("%d is a palindrome",copy);
    else 
    printf("%d is not a palindrome",copy);
    return 0;
}